{
  "name": "flutter-ninja",
  "displayName": "Flutter Ninja",
  "publisher": "MacMauriceOsuji",
  "description": "Compose a Flutter foundation with clean architecture, starter blueprints, and independent Android and iOS build setup",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/McMaurice/flutter-ninja-vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "flutter",
    "dart",
    "scaffold",
    "generator",
    "architecture"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "icon": "images/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "flutter-ninja.generateArchitecture",
        "title": "Flutter Ninja: Configure Project",
        "category": "Flutter Ninja"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutter-ninja.generateArchitecture",
          "when": "explorerResourceIsFolder",
          "group": "flutterNinja@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
